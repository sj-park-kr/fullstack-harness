{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Artifact"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/statusline.mjs\""
  },
  "skillOverrides": {
    "harness-evolve": "user-invocable-only",
    "computer-use": "user-invocable-only",
    "orca-cli": "user-invocable-only",
    "orchestration": "user-invocable-only",
    "find-skills": "user-invocable-only",
    "dataviz": "user-invocable-only",
    "artifact-design": "user-invocable-only",
    "artifact-diagramming": "user-invocable-only",
    "artifact-capabilities": "user-invocable-only",
    "update-config": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "loop": "user-invocable-only",
    "schedule": "user-invocable-only",
    "claude-in-chrome": "user-invocable-only",
    "run": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "mp-code-review": "user-invocable-only",
    "mp-codebase-design": "user-invocable-only",
    "mp-diagnosing-bugs": "user-invocable-only",
    "mp-domain-modeling": "user-invocable-only",
    "mp-git-guardrails-claude-code": "user-invocable-only",
    "mp-migrate-to-shoehorn": "user-invocable-only",
    "mp-pr": "user-invocable-only",
    "mp-prototype": "user-invocable-only",
    "mp-research": "user-invocable-only",
    "mp-scaffold-exercises": "user-invocable-only",
    "mp-setup-pre-commit": "user-invocable-only",
    "mp-tdd": "user-invocable-only",
    "mp-wizard": "user-invocable-only",
    "mp-writing-for-agents": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Glob|Bash|PowerShell|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/caveman.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/caveman.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
